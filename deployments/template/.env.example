# Deployment template configuration: cp .env.example .env, then fill in real values.
# .env holds secrets: keep it out of git, readable only by the operator account.
# Every value below is a placeholder or a non-secret setting; none is a real secret.

# --- Image and host exposure ---------------------------------------------------
# A locally built, explicitly tagged image (see README.md). No registry is used.
API_IMAGE=commerce-ai-platform-api:0.1.0
# Published on 127.0.0.1 ONLY. Put a reviewed reverse proxy in front for remote access.
PRODUCT_API_PORT=8000

# --- Database (this deployment's own PostgreSQL; never shared) -------------------
POSTGRES_DB=platform
POSTGRES_USER=platform
# REQUIRED secret. Use a URL-safe random value (it is embedded in the database URL),
# e.g.  openssl rand -hex 32
POSTGRES_PASSWORD=

# --- Product environment ----------------------------------------------------------
# production | staging | local | test
APP_ENVIRONMENT=production
APP_LOG_LEVEL=INFO

# --- Product API authentication (required in staging/production) ------------------
APP_PRODUCT_AUTH_MODE=api_key
# The single company this installation serves.
APP_COMPANY_ID=
# JSON array of principals holding only SHA-256 key hashes, never raw keys
# (see apps/api/scripts/hash_product_api_key.py).
APP_PRODUCT_API_KEYS=[]

# --- AgentOS runtime guard ----------------------------------------------------------
# REQUIRED secret, at least 32 characters, e.g.  openssl rand -hex 32
OS_SECURITY_KEY=

# --- Business backend -------------------------------------------------------------
# No real business backend exists yet. "disabled" in production INTENTIONALLY REFUSES
# to start (fail closed) until a reviewed real backend is installed. Never use "mock"
# for a deployment: it is local/test only and refused in staging/production.
APP_BUSINESS_BACKEND=disabled
# Directory PATHS inside the API container (mounted read-only by an operator override)
# for a future real backend's declared inputs. Blank while no backend needs inputs.
APP_BACKEND_CONFIG_DIR=
APP_BACKEND_SECRETS_DIR=

# --- Default model -------------------------------------------------------------------
# disabled | openai | anthropic (a provider requires APP_DEFAULT_MODEL_ID and its key).
APP_DEFAULT_MODEL_PROVIDER=disabled
APP_DEFAULT_MODEL_ID=
# Secrets: only the selected provider's key, supplied here at runtime.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
