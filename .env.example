# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Never commit real credentials. Placeholders below are NOT secrets.

# --- Infrastructure (docker-compose.yml) -----------------------------------
POSTGRES_DB=platform
POSTGRES_USER=platform
# Required. Choose any local-only value.
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API (apps/api, prefix APP_) ---------------------------------------------
APP_NAME=commerce-ai-platform
# local | test | staging | production. API docs (/docs, /redoc, /openapi.json) are only
# served in local/test; they are always disabled in staging/production.
APP_ENVIRONMENT=local
APP_DEBUG=false
# DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO
APP_API_HOST=127.0.0.1
APP_API_PORT=8000
# Required: the agent runtime persists to PostgreSQL. Must match the infrastructure values above.
APP_DATABASE_URL=postgresql+psycopg://platform:change-me-local-only@localhost:5432/platform
# Optional (not used yet).
APP_REDIS_URL=redis://localhost:6379/0
# PostgreSQL schema owned by Agno for its runtime tables (created by Agno on startup).
APP_AGNO_DB_SCHEMA=agno_runtime

# --- Product API authentication (NOT the AgentOS OS_SECURITY_KEY) ---------------
# disabled | api_key. "disabled" is allowed only in local/test; staging/production refuse
# to start without Product authentication. Clients send: Authorization: Bearer <key>.
APP_PRODUCT_AUTH_MODE=disabled
# The single company this deployment serves (every API principal belongs to it).
APP_COMPANY_ID=
# JSON array of principals. Each holds only the SHA-256 of its key, NEVER the raw key:
#   [{"key_id": "...", "key_sha256": "<64 lowercase hex>", "actor_id": "...",
#     "role_ids": [...], "permissions": [...], "store_ids": [...]}]
# Hash a key without putting it on the command line:
#   uv run python apps/api/scripts/hash_product_api_key.py   (prompts; input hidden)
APP_PRODUCT_API_KEYS=[]

# --- Integration management (docs/INTEGRATIONS.md) --------------------------------
# Optional. Absolute path of an existing private directory (owned by the API user, not
# group/world-writable) holding integration credential values UNENCRYPTED: protection
# depends on that volume (no KMS/HSM). Unset: credential-bearing connections are refused.
# This build installs no integration type. Grant integrations.read / integrations.manage
# to a Product API key to use /api/v1/integrations/*.
# APP_INTEGRATION_SECRETS_DIR=

# --- Business backend (deployment factory app.bootstrap) -----------------------
# A Product-owned backend plugin ID (not a module/class/import path; those are not
# supported). Available IDs today: disabled | mock, both LOCAL/TEST ONLY. "disabled":
# no Product business services (those routes answer 503). "mock": deterministic
# in-memory commerce/ticketing on the real Product core; needs a default model below.
# Staging/production deployments are refused: no real business backend exists yet.
# Never use mock for a deployment.
APP_BUSINESS_BACKEND=disabled

# --- Business backend inputs (DIRECTORY PATHS ONLY, never values) ---------------
# A backend registration declares the NAMES of the config/secret inputs it needs; at
# startup the Product reads exactly <dir>/<NAME> for those names (no directory
# scanning, no fallback) and hands them to the backend builder. disabled and mock
# declare none, so both may stay blank. Keep secret files outside the repository,
# owned by the service account and not group/world readable; never put their
# contents here. Changes take effect on restart (no rotation or hot reload).
APP_BACKEND_CONFIG_DIR=
APP_BACKEND_SECRETS_DIR=

# --- Default model (deployment default for generic agents) ---------------------
# disabled | openai | anthropic. "disabled" needs no provider key and registers no
# live agent. When a provider is selected, APP_DEFAULT_MODEL_ID is required and there
# is deliberately no default: model IDs change, so choose one explicitly, e.g.
#   APP_DEFAULT_MODEL_ID=<an OpenAI model ID>     (example only, not a default)
APP_DEFAULT_MODEL_PROVIDER=disabled
APP_DEFAULT_MODEL_ID=

# --- Model provider credentials (read by Agno's model classes, no APP_ prefix) --
# Only the key for the selected provider is required. Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Agno runtime (read by Agno itself, no APP_ prefix) --------------------------
# Required, at least 32 characters (startup is refused otherwise). Bearer key protecting
# the AgentOS runtime routes. Temporary runtime guard, not product authentication.
# Generate one with:  openssl rand -hex 32
OS_SECURITY_KEY=
# Agno usage telemetry is disabled by product policy in code (every Agent and AgentOS
# use telemetry=False); the code does not depend on this variable being present.
# Kept as defense in depth. Only unset or "false" is accepted: "true" (or any other
# value) is rejected at startup.
AGNO_TELEMETRY=false

# --- Web (apps/web) ------------------------------------------------------------
# The Operations Console reads its server-only PRODUCT_API_ORIGIN from apps/web/.env.local
# (see apps/web/.env.example). The browser never calls the API origin directly, and no
# NEXT_PUBLIC_* variable carries an API address or credential.
