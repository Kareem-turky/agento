# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Never commit real credentials. Placeholders below are NOT secrets.

# --- Infrastructure (docker-compose.yml) -----------------------------------
POSTGRES_DB=platform
POSTGRES_USER=platform
# Required. Choose any local-only value.
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API (apps/api, prefix APP_) ---------------------------------------------
APP_NAME=commerce-ai-platform
# local | test | staging | production
APP_ENVIRONMENT=local
APP_DEBUG=false
# DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO
APP_API_HOST=127.0.0.1
APP_API_PORT=8000
# Optional until a component needs them. Must match the infrastructure values above.
APP_DATABASE_URL=postgresql+psycopg://platform:change-me-local-only@localhost:5432/platform
APP_REDIS_URL=redis://localhost:6379/0

# --- Agno ----------------------------------------------------------------------
# Disable Agno's anonymous usage telemetry.
AGNO_TELEMETRY=false

# --- Web (apps/web) ------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
