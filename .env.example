# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Never commit real credentials. Placeholders below are NOT secrets.

# --- Infrastructure (docker-compose.yml) -----------------------------------
POSTGRES_DB=platform
POSTGRES_USER=platform
# Required. Choose any local-only value.
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API (apps/api, prefix APP_) ---------------------------------------------
APP_NAME=commerce-ai-platform
# local | test | staging | production. API docs (/docs, /redoc, /openapi.json) are only
# served in local/test; they are always disabled in staging/production.
APP_ENVIRONMENT=local
APP_DEBUG=false
# DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO
APP_API_HOST=127.0.0.1
APP_API_PORT=8000
# Required: the agent runtime persists to PostgreSQL. Must match the infrastructure values above.
APP_DATABASE_URL=postgresql+psycopg://platform:change-me-local-only@localhost:5432/platform
# Optional (not used yet).
APP_REDIS_URL=redis://localhost:6379/0
# PostgreSQL schema owned by Agno for its runtime tables (created by Agno on startup).
APP_AGNO_DB_SCHEMA=agno_runtime

# --- Default model (deployment default for generic agents) ---------------------
# disabled | openai | anthropic. "disabled" needs no provider key and registers no
# live agent. When a provider is selected, APP_DEFAULT_MODEL_ID is required and there
# is deliberately no default: model IDs change, so choose one explicitly, e.g.
#   APP_DEFAULT_MODEL_ID=<an OpenAI model ID>     (example only, not a default)
APP_DEFAULT_MODEL_PROVIDER=disabled
APP_DEFAULT_MODEL_ID=

# --- Model provider credentials (read by Agno's model classes, no APP_ prefix) --
# Only the key for the selected provider is required. Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Agno runtime (read by Agno itself, no APP_ prefix) --------------------------
# Required, at least 32 characters (startup is refused otherwise). Bearer key protecting
# the AgentOS runtime routes. Temporary runtime guard, not product authentication.
# Generate one with:  openssl rand -hex 32
OS_SECURITY_KEY=
# Disable Agno's anonymous usage telemetry.
AGNO_TELEMETRY=false

# --- Web (apps/web) ------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
