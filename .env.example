# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Never commit real credentials. Placeholders below are NOT secrets.

# --- Infrastructure (docker-compose.yml) -----------------------------------
POSTGRES_DB=platform
POSTGRES_USER=platform
# Required. Choose any local-only value.
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API (apps/api, prefix APP_) ---------------------------------------------
APP_NAME=commerce-ai-platform
# local | test | staging | production
APP_ENVIRONMENT=local
APP_DEBUG=false
# DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO
APP_API_HOST=127.0.0.1
APP_API_PORT=8000
# Required: the agent runtime persists to PostgreSQL. Must match the infrastructure values above.
APP_DATABASE_URL=postgresql+psycopg://platform:change-me-local-only@localhost:5432/platform
# Optional (not used yet).
APP_REDIS_URL=redis://localhost:6379/0
# PostgreSQL schema owned by Agno for its runtime tables (created by Agno on startup).
APP_AGNO_DB_SCHEMA=agno_runtime

# --- Agno runtime (read by Agno itself, no APP_ prefix) --------------------------
# Required. Bearer key protecting the AgentOS runtime routes. Temporary runtime guard,
# not product authentication. Generate a local value, e.g.:  openssl rand -hex 32
OS_SECURITY_KEY=
# Disable Agno's anonymous usage telemetry.
AGNO_TELEMETRY=false

# --- Web (apps/web) ------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
